<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SqueakerUpdater</AssemblyName>
    <ApplicationIcon>../Squeaker/Assets/Squeaker.ico</ApplicationIcon>
    <Product>Squeaker</Product>
    <!-- One standalone exe: it runs from a temp copy, away from the app's runtime files. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squeaker.Core\Squeaker.Core.csproj" />
  </ItemGroup>
</Project>
