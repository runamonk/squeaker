<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Squeaker.SettingsWindow"
        Title="Squeaker Settings"
        Icon="/Assets/Squeaker.ico"
        Width="560" Height="640" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- One section per area. New options go in the section they belong to. -->
        <ScrollViewer>
            <StackPanel Margin="24,6,24,24">
                <TextBlock Classes="section" Text="General" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Pause and resume hotkey" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Column="1" x:Name="PauseHotkeyBox" Width="170" IsReadOnly="True"
                             PlaceholderText="None" />
                    <Button Grid.Column="2" Classes="action" Content="Clear" Margin="8,0,0,0" Click="ClearHotkey_Click" />
                </Grid>
                <TextBlock Classes="note" Margin="0,0,0,6" Text="Click the box and press the keys. Needs Ctrl, Alt or Win, plus a letter, digit or F-key." />

                <!-- Only shown while Windows' own version is switched on. -->
                <Border x:Name="WindowsHidingPanel" IsVisible="False" Margin="0,12,0,0" Padding="14,10"
                        Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppLineBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Windows' own &quot;Hide pointer while typing&quot; is on. In older apps like Notepad it hides the cursor itself and overrides the shortcut, excluded app and bring-it-back options below." />
                        <Button Grid.Column="1" Classes="action" Content="Turn it off" Click="TurnOffWindowsHiding_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Classes="section" Text="Hiding the cursor" />
                <CheckBox x:Name="HideOnTypingBox" Content="Hide the cursor while typing" />
                <TextBlock Classes="note" Text="Shift, Ctrl, Alt and Win on their own don't count, and nor do keys sent by other programs." />
                <CheckBox x:Name="IgnoreShortcutsBox" Content="Leave it alone for shortcuts (Ctrl, Alt or Win + a key)" Margin="0,6,0,0" />
                <TextBlock Classes="note" Text="So Ctrl+C, Alt+Tab and the like don't make it vanish." />

                <CheckBox x:Name="HideOnIdleBox" Content="Hide the cursor when the mouse is idle" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Hide after the mouse hasn't moved for (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" x:Name="IdleSecondsBox" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130" />
                </Grid>

                <TextBlock Classes="section" Text="Bringing it back" />
                <TextBlock Classes="note" Margin="0,0,0,6" Text="Moving the mouse, clicking or scrolling always brings it back." />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Ignore mouse movement smaller than (pixels)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" x:Name="MoveThresholdBox" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="130" />
                </Grid>
                <TextBlock Classes="note" Margin="0,0,0,6" Text="So a bumped desk doesn't bring it back." />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Also bring it back after you stop typing for (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" x:Name="ShowAfterTypingBox" Minimum="0" Maximum="600" Increment="1" FormatString="0" Width="130" />
                </Grid>
                <TextBlock Classes="note" Margin="0,0,0,6" Text="0 turns it off: it stays hidden until you touch the mouse." />

                <TextBlock Classes="section" Text="Games" />
                <CheckBox x:Name="StepAsideBox" Content="Step aside while a full-screen app is in front" />
                <TextBlock Classes="note" Text="Games (full screen or borderless), full-screen videos and the like. Squeaker lets go of the keyboard and mouse completely, so it adds nothing to mouse latency and can't flicker the cursor. Windowed games: add them below." />

                <TextBlock Classes="section" Text="Excluded apps" />
                <TextBlock Classes="note" Margin="0,0,0,8" Text="Squeaker steps aside the same way while one of these is in front. One process name per line, e.g. mstsc or game.exe." />
                <TextBox x:Name="ExcludedBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="primary action" Content="Save" IsDefault="True" Click="Save_Click" />
                <Button Classes="action" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
