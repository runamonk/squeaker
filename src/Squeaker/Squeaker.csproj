<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Squeaker.ico</ApplicationIcon>
    <AssemblyTitle>Squeaker</AssemblyTitle>
    <Product>Squeaker</Product>
    <Description>Hides the mouse cursor while you type.</Description>
    <Version>0.0.0-dev</Version>
    <!-- Compile ahead of time when publishing: faster start, and the hooks never wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squeaker.Core\Squeaker.Core.csproj" />
  </ItemGroup>
</Project>
